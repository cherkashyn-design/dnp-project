{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/cases/drumkit-logistic-saas",
      "destination": "/cases",
      "permanent": false
    },
    {
      "source": "/cases/yummo-food-guide-for-moms",
      "destination": "/cases",
      "permanent": false
    },
    {
      "source": "/cases/nodify",
      "destination": "/cases/nodity",
      "permanent": true
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2/:path*",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|robots\\.txt$|sitemap\\.xml$|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
